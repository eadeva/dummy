@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #465E70
skinparam ArrowFontSize 12
skinparam ParticipantBackgroundColor #F0F6FB
skinparam ParticipantBorderColor #2478AD
skinparam BoxPadding 5
skinparam sequenceMessageAlign center
skinparam sequenceGroupBackgroundColor #F6F9FB
skinparam sequenceGroupBorderColor #9BB1C0
hide footbox

participant "Caller" as Caller
participant "PTk orchestration" as PTk
participant "Step execution" as Steps #EFF8F5
participant "Results / history" as Reports #FFF6E6

Caller -> PTk : job + variants + parameters
PTk -> PTk : load, validate, prepare
alt configuration / preparation failed
  PTk --> Caller : error; no job starts
else dry run
  PTk --> Caller : graph + prepared preview
else run
  group Per selected variant
    PTk -> PTk : acquire job / variant lock
    PTk -> Steps : schedule ready steps by needs
    Steps --> PTk : status + logs + tool results
    PTk -> Reports : retain evidence; import and export
    Reports --> PTk : report paths and report problems
  end
  PTk --> Caller : exit status
end
@enduml
