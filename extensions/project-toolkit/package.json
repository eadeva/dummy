{
  "name": "project-toolkit",
  "displayName": "Project Toolkit",
  "description": "Run PTK jobs, workflows and built-in commands, browse help, select variants and open reports.",
  "version": "0.15.0",
  "publisher": "eadeva",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eadeva/dummy",
    "directory": "extensions/project-toolkit"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:.main.ptk.yml",
    "workspaceContains:.repo/project.list"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "PTK loads project configuration and may load configured Python plugins."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "PTK requires a filesystem and a local process on the extension host."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "project-toolkit",
          "title": "Project Toolkit",
          "icon": "media/toolkit.svg"
        }
      ]
    },
    "views": {
      "project-toolkit": [
        {
          "id": "project-toolkit.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "project-toolkit.projects",
        "contents": "Open a PTK repository or VMR folder, then [refresh](command:project-toolkit.refresh).\nPTK must be installed on the machine running this workspace."
      }
    ],
    "commands": [
      {
        "command": "project-toolkit.refresh",
        "title": "Refresh Projects",
        "category": "Project Toolkit",
        "icon": "$(refresh)"
      },
      {
        "command": "project-toolkit.run",
        "title": "Run Job or Workflow",
        "category": "Project Toolkit",
        "icon": "$(play)"
      },
      {
        "command": "project-toolkit.preview",
        "title": "Dry Run Job or Workflow",
        "category": "Project Toolkit",
        "icon": "$(inspect)"
      },
      {
        "command": "project-toolkit.runWithParameters",
        "title": "Run Job or Workflow with Options",
        "category": "Project Toolkit",
        "icon": "$(settings-gear)"
      },
      {
        "command": "project-toolkit.selectVariant",
        "title": "Select Variant for Jobs and Workflows",
        "category": "Project Toolkit",
        "icon": "$(list-selection)"
      },
      {
        "command": "project-toolkit.showVariant",
        "title": "Display Variant",
        "category": "Project Toolkit",
        "icon": "$(info)"
      },
      {
        "command": "project-toolkit.openReport",
        "title": "Open Latest Job or Workflow Report",
        "category": "Project Toolkit",
        "icon": "$(open-preview)"
      },
      {
        "command": "project-toolkit.validate",
        "title": "Validate Configuration",
        "category": "Project Toolkit",
        "icon": "$(check)"
      },
      {
        "command": "project-toolkit.openConfig",
        "title": "Open Configuration",
        "category": "Project Toolkit",
        "icon": "$(go-to-file)"
      },
      {
        "command": "project-toolkit.showHelp",
        "title": "Show Help",
        "category": "Project Toolkit",
        "icon": "$(question)"
      },
      {
        "command": "project-toolkit.runBuiltin",
        "title": "Run Command",
        "category": "Project Toolkit",
        "icon": "$(play)"
      },
      {
        "command": "project-toolkit.runBuiltinWithParameters",
        "title": "Run Command with Options",
        "category": "Project Toolkit",
        "icon": "$(settings-gear)"
      },
      {
        "command": "project-toolkit.clean",
        "title": "Clean Job or Workflow Outputs",
        "category": "Project Toolkit",
        "icon": "$(trash)"
      },
      {
        "command": "project-toolkit.reRun",
        "title": "Clean Outputs and Re-run Job or Workflow",
        "category": "Project Toolkit",
        "icon": "$(debug-restart)"
      },
      {
        "command": "project-toolkit.openConfigForm",
        "title": "Open PTK Form",
        "category": "Project Toolkit",
        "icon": "$(settings-gear)"
      },
      {
        "command": "project-toolkit.init",
        "title": "Initialize PTK Project",
        "category": "Project Toolkit"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "project-toolkit.validate",
          "when": "view == project-toolkit.projects",
          "group": "navigation@1"
        },
        {
          "command": "project-toolkit.refresh",
          "when": "view == project-toolkit.projects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "project-toolkit.run",
          "when": "view == project-toolkit.projects && viewItem =~ /^(job|workflow)/",
          "group": "inline@1"
        },
        {
          "command": "project-toolkit.preview",
          "when": "view == project-toolkit.projects && viewItem =~ /^(job|workflow)/",
          "group": "inline@2"
        },
        {
          "command": "project-toolkit.runWithParameters",
          "when": "view == project-toolkit.projects && viewItem =~ /^(job|workflow)/",
          "group": "inline@3"
        },
        {
          "command": "project-toolkit.openReport",
          "when": "view == project-toolkit.projects && viewItem =~ /^(job|workflow)-report$/",
          "group": "inline@5"
        },
        {
          "command": "project-toolkit.selectVariant",
          "when": "view == project-toolkit.projects && viewItem =~ /^(job|workflow)/",
          "group": "inline@3"
        },
        {
          "command": "project-toolkit.showVariant",
          "when": "view == project-toolkit.projects && viewItem == variant",
          "group": "inline@1"
        },
        {
          "command": "project-toolkit.showHelp",
          "when": "view == project-toolkit.projects && viewItem =~ /^(job|workflow|builtin)/",
          "group": "inline@4"
        },
        {
          "command": "project-toolkit.runBuiltin",
          "when": "view == project-toolkit.projects && viewItem == builtin",
          "group": "inline@1"
        },
        {
          "command": "project-toolkit.runBuiltinWithParameters",
          "when": "view == project-toolkit.projects && viewItem == builtin",
          "group": "inline@2"
        },
        {
          "command": "project-toolkit.clean",
          "when": "view == project-toolkit.projects && viewItem =~ /^(job|workflow)/",
          "group": "inline@6"
        },
        {
          "command": "project-toolkit.reRun",
          "when": "view == project-toolkit.projects && viewItem =~ /^(job|workflow)/",
          "group": "inline@7"
        }
      ],
      "editor/title": [
        {
          "command": "project-toolkit.openConfigForm",
          "when": "resourceFilename =~ /\\.ptk\\.ya?ml$/ && isWorkspaceTrusted",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Project Toolkit",
      "properties": {
        "projectToolkit.executable": {
          "type": "string",
          "default": "ptk",
          "scope": "resource",
          "description": "PTK executable or absolute path. For a prepared uv environment, set this to uv and arguments to [\"run\", \"--no-sync\", \"ptk\"]. The extension enforces --no-sync for uv run so launching PTK does not reinstall packages."
        },
        "projectToolkit.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Arguments before PTK options, for example [\"run\", \"ptk\"] when the executable is uv."
        },
        "projectToolkit.discoveryTimeout": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 300,
          "scope": "resource",
          "description": "Timeout in seconds for read-only project discovery; does not limit job execution."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "project-toolkit",
        "required": [
          "kind",
          "name",
          "root"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "job",
              "workflow",
              "builtin"
            ]
          },
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "variant": {
            "type": "string",
            "description": "Job variant or workflow owner variant (repository mappings are resolved by PTK)."
          },
          "preview": {
            "type": "boolean",
            "default": false,
            "description": "Dry-run without executing the job or workflow. Not supported for built-in commands."
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Non-secret job parameter overrides; required parameters must be supplied."
          },
          "help": {
            "type": "boolean",
            "default": false,
            "description": "Display command or job help without running it or requiring parameters."
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Non-secret built-in arguments and options, keyed by parameter name; each array holds literal values."
          },
          "clean": {
            "type": "boolean",
            "default": false,
            "description": "Delete selected output folders and stop."
          },
          "reRun": {
            "type": "boolean",
            "default": false,
            "description": "Delete selected output folders and then execute."
          },
          "report": {
            "type": "boolean",
            "default": false,
            "description": "Open the latest job report for the selected variant, or the latest aggregate workflow report, without executing it."
          },
          "runOptions": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "PTK run option values, keyed by inventory parameter name. For example end: [\"build\"] includes prerequisites, while only_step: [\"build\"] runs just that step."
          }
        },
        "when": "processExecutionSupported && isWorkspaceTrusted"
      }
    ],
    "customEditors": [
      {
        "viewType": "project-toolkit.configuration",
        "displayName": "PTK Configuration",
        "selector": [
          {
            "filenamePattern": "*.ptk.yml"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "check": "node --check src/core.js && node --check src/extension.js && node --check src/config-model.js && node --check src/editors.js && node --check src/parameters.js && node --check media/schema.js && node --check media/presentation.js && node --check media/editor.js && node --check media/variables.js",
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies --skip-license",
    "vscode:prepublish": "npm run check && npm test && npm run build",
    "build": "esbuild src/extension.js --bundle --platform=node --target=node20 --external:vscode --outfile=dist/extension.js"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
